# Public Convex URLs for prod:decisive-terrier-395. Not secrets.
# Vite loads this file for `npm run build` only. Local `npm run dev` does not.
# MISTRAL_*, OTP_ENDPOINT, CHAT_ID, SECRET_KEY, and CONVEX_DEPLOY_KEY do not belong here.
VITE_CONVEX_URL=https://decisive-terrier-395.eu-west-1.convex.cloud
VITE_CONVEX_SITE_URL=https://decisive-terrier-395.eu-west-1.convex.site

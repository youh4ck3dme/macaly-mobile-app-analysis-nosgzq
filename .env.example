# Written by `npx convex dev` into .env.local. Do not commit .env.local or secrets.
# VITE_CONVEX_URL=http://127.0.0.1:3210
# VITE_CONVEX_SITE_URL=http://127.0.0.1:3211
# CONVEX_DEPLOYMENT=anonymous:anonymous-agent

# Frontend origin used by @convex-dev/auth. Local dev: http://localhost:3000
# SITE_URL=http://localhost:3000

# Production OTP delivery (Convex deployment env, not only the Vite shell).
# Required on hosted *.convex.cloud deployments. Never commit real values.
# OTP_ENDPOINT=https://example.com/otp
# CHAT_ID=
# SECRET_KEY=
# APP_NAME=macaly-mobile-app-analysis

# Local console OTP. Set on a local/anonymous backend or a dev deployment
# (`CONVEX_DEPLOYMENT=dev:...`). Ignored on prod/preview and on a hosted
# cloud deployment that is not explicitly dev. Never set this in production.
# AUTH_DEV_OTP=1

# Other server secrets used by this app. Set with `npx convex env set`.
# MISTRAL_KEY=

# Public Convex URLs for prod deployment decisive-terrier-395 (eu-west-1).
# These are not secrets. Set them on the host of https://forenx.bizagent.sk.
# `npx convex dev` writes a local override into .env.local — never commit that file.
# Do not put MISTRAL_*, OTP tokens, SECRET_KEY, or CONVEX_DEPLOY_KEY in VITE_*.
VITE_CONVEX_URL=https://decisive-terrier-395.eu-west-1.convex.cloud
VITE_CONVEX_SITE_URL=https://decisive-terrier-395.eu-west-1.convex.site

# Example local values written by `npx convex dev` into .env.local.
# VITE_CONVEX_URL=http://127.0.0.1:3210
# VITE_CONVEX_SITE_URL=http://127.0.0.1:3211
# CONVEX_DEPLOYMENT=anonymous:anonymous-agent

# Convex deployment env. Set with `npx convex env set` on prod:decisive-terrier-395.
# Names only here — never commit values of secrets.
# SITE_URL=https://forenx.bizagent.sk
# Local dev: SITE_URL=http://localhost:3000

# Required before a production auth deploy. Without them, sign-in must fail
# closed and must not print [DEV OTP].
# OTP_ENDPOINT=
# CHAT_ID=
# SECRET_KEY=
# APP_NAME=macaly-mobile-app-analysis

# Local console OTP only. Ignored on prod/preview and on hosted *.convex.cloud
# when the deployment is not explicitly dev. Never set this on prod:decisive-terrier-395.
# AUTH_DEV_OTP=1

# Server-only. Convex env, never VITE_* and never the frontend bundle.
# MISTRAL_API_KEY=
# MISTRAL_KEY=
